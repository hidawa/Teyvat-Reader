{
  "name": "Teyvat-Reader",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/nvidia-cuda:1": {
      "version": "12.2"
    }
  },
  "runArgs": ["--gpus", "all"],
  "containerEnv": {
    "NVIDIA_VISIBLE_DEVICES": "all",
    "NVIDIA_DRIVER_CAPABILITIES": "compute,utility"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"]
    }
  },
  // TODO: どちらか分けたい
  // "postCreateCommand": "pip install uv && uv add -r requirements.txt"
  "postCreateCommand": "pip install uv && uv sync && uv pip install torch --torch-backend=auto"
}